{
  "name": "@tpointurier/ally-microsoft",
  "description": "An ally driver for Microsoft",
  "version": "0.2.0",
  "main": "build/index.js",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "npm run compile",
    "clean": "del-cli build",
    "compile": "npm run clean && tsc",
    "lint": "eslint . --ext=.ts",
    "release": "np",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/core": "^7.3.3",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0",
    "@types/node": "^25.9.1",
    "del-cli": "^7.0.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "np": "^11.2.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@adonisjs/ally": "^6.0.0",
    "@adonisjs/core": "^7.0.0"
  },
  "author": "Thibault Pointurier <thibault.pointurier.pro@gmail.com>",
  "license": "MIT",
  "keywords": [
    "ally",
    "microsoft",
    "adonis",
    "adonisjs",
    "oauth2",
    "social-auth"
  ],
  "prettier": "@adonisjs/prettier-config",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "np": {
    "message": "chore(release): %s",
    "tag": "latest",
    "branch": "main",
    "anyBranch": false
  }
}